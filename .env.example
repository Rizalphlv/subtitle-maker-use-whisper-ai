APP_NAME="Subtitle System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=subtitle_system
DB_USERNAME=subtitle
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------
# MinIO (S3-compatible storage)
# -------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=subtitles
AWS_ENDPOINT=http://minio:9000
# Public HTTPS S3 endpoint used only by the mobile presigning disk.
AWS_PUBLIC_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_PUBLIC_USE_PATH_STYLE_ENDPOINT=true

# Audio subtitle REST API
SUBTITLE_INPUT_DISK=minio
SUBTITLE_OUTPUT_DISK=minio
SUBTITLE_PRESIGN_DISK=minio_presign
SUBTITLE_MAX_UPLOAD_KB=102400
SUBTITLE_POLL_INTERVAL_SECONDS=60
SUBTITLE_SIGNED_URL_MINUTES=60
SUBTITLE_INPUT_RETENTION_HOURS=24
SUBTITLE_OUTPUT_RETENTION_DAYS=30
SUBTITLE_FAILED_RETENTION_DAYS=7
SUBTITLE_JOB_TRIES=10
SUBTITLE_JOB_MAX_EXCEPTIONS=3
SUBTITLE_JOB_TIMEOUT=7200
SUBTITLE_JOB_LOCK_SECONDS=7500
SUBTITLE_JOB_LOCK_RELEASE_SECONDS=900
SUBTITLE_API_RATE_LIMIT=60
SUBTITLE_API_UPLOADS_PER_HOUR=20
SUBTITLE_AUDIO_QUEUE=audio-subtitles
# Must exceed the 7200-second job/worker timeout and 7500-second lock lifetime.
SUBTITLE_AUDIO_QUEUE_RETRY_AFTER=7800

# -------------------------------------------------
# OpenAI Whisper (speech translation to English subtitles)
# -------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_BATCH_SIZE=8
OPENAI_TRANSLATION_CONTEXT_SIZE=3
OPENAI_TIMEOUT=600
# Optional vocabulary/context only. Leave empty unless names or specialist terms need help.
OPENAI_WHISPER_PROMPT=

VITE_APP_NAME="${APP_NAME}"
